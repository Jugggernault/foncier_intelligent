# PostGIS : conteneur local (voir README) ou chaîne de connexion Supabase (pooler, port 6543)
DATABASE_URL=postgres://postgres:postgres@localhost:54322/foncier
# Chargement des couches : pooler de session Supabase (port 5432) ; à défaut, DATABASE_URL est utilisé
DIRECT_URL=
# Agent conversationnel : OpenRouter (API compatible OpenAI)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Lecture en direct de l'API et du WFS de l'ANDF pour les NUP hors démonstration (à la demande, cache 24 h)
ANDF_LIVE=false

# Sceau des rapports de vérification (HMAC). À définir sur Vercel : openssl rand -hex 32
REPORT_SECRET=

# Ilèmi sur WhatsApp (Twilio). Webhook : https://<domaine>/api/whatsapp
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Affichage du lien WhatsApp sur /assistant (ex. +14155238886 et « join mot-code » du bac à sable)
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_WHATSAPP_JOIN=
