      "css": ".ds-field{background:#093e73;padding:32px}.ds-verdict{max-width:420px;background:#fff;color:#0d1b2a;border-radius:6px;overflow:hidden;box-shadow:0 24px 60px -20px rgba(2,12,27,.65)}.ds-verdict header{padding:20px 24px 16px;font-family:Figtree,system-ui,sans-serif}.ds-verdict small{display:block;font-size:.75rem;color:#4a5a6e}.ds-verdict strong{display:block;font:800 1.5rem Archivo,system-ui,sans-serif;font-variation-settings:'wdth' 112;letter-spacing:.04em;font-variant-numeric:tabular-nums;color:#093e73}.ds-verdict header span{font-size:.875rem;color:#4a5a6e}.ds-band{display:flex;gap:12px;align-items:flex-start;padding:16px 24px;background:#b3122b;color:#fff}.ds-band p{margin:0;font:800 1.125rem/1.35 Archivo,system-ui,sans-serif;font-variation-settings:'wdth' 112}"
