      "css": ".ds-chips{display:flex;gap:8px;background:#093e73;padding:16px}.ds-chip{text-align:left;padding:8px 12px;border:1px solid rgba(255,255,255,.2);border-radius:4.8px;background:transparent;color:rgba(255,255,255,.8);cursor:pointer;transition:border-color .15s,color .15s}.ds-chip b{display:block;font:700 .875rem Archivo,system-ui,sans-serif;font-variation-settings:'wdth' 112;letter-spacing:.04em;font-variant-numeric:tabular-nums}.ds-chip span{display:block;font:400 .75rem Figtree,system-ui,sans-serif;color:rgba(255,255,255,.6)}.ds-chip:hover{border-color:rgba(255,255,255,.5);color:#fff}.ds-chip[aria-pressed=true]{border-color:#fff;background:rgba(255,255,255,.1);color:#fff}.ds-chip:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(255,212,0,.6)}"
